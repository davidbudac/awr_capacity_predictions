# bench/env.sh -- local, untracked. Copy from env.sh.example and edit.
#
# Everything the harness needs to reach the test DB. No credential ever lives
# in a tracked file; charbench/oewizard get user+password via -u/-p overrides.

# --- swingbench client (runs on the workstation, not in the VM) -------------
export SWINGBENCH_HOME=/home/db/swingbench

# --- target database --------------------------------------------------------
# ol9_19_dg1 (libvirt/KVM). 192.168.56.x is the host-only network, reachable
# directly from the workstation; port 1521 is the VM's own listener.
export DB_HOST=192.168.56.111
export DB_PORT=1521
export DB_SERVICE=pdb1.world
export CONNECT_STRING="//${DB_HOST}:${DB_PORT}/${DB_SERVICE}"

# --- SSH into the VM (used only for the SQL*Plus setup/teardown steps) ------
export DBMINT_SSH_PORT=2200
export DBMINT_SSH_USER=oracle
export DBMINT_SSH_HOST=dbmint
export DBMINT_ORACLE_SID=cdb1
export DBMINT_PDB=PDB1

# --- benchmark schemas ------------------------------------------------------
export SOE_USER=soe
export SOE_PASS=change_me
export SH_USER=sh
export SH_PASS=change_me

# A DBA account inside PDB1 used only by the wizards (created by setup.sh, so
# the SYS password never has to be known or typed).
export BENCH_ADMIN_USER=benchadm
export BENCH_ADMIN_PASS=change_me

# --- sizing knobs -----------------------------------------------------------
export SCHEMA_SCALE=1          # oewizard/shwizard -scale (~1 GB each at 1)
export WIZARD_THREADS=4        # -tc; keep low, the VM has 2 vCPUs
export TBS_MAXSIZE=6G
# Online/standby redo group size (MB) used by setup.sh --redo.
REDO_MB=512          # capped autoextend: days_to_full needs a bound
