{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Capacity Prediction Workflow",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "tier2",
      "label": "Tier 2: OML ESM"
    },
    {
      "id": "source",
      "label": "AWR Source"
    },
    {
      "id": "tier1",
      "label": "Tier 1: SQL Regression"
    },
    {
      "id": "output",
      "label": "Verdict + Report"
    }
  ],
  "phases": [
    {
      "id": "ingest",
      "label": "Ingest",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "fit",
      "label": "Fit + project",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "judge",
      "label": "Compare + report",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "awr",
    "seam",
    "daily",
    "trend",
    "project",
    "compare",
    "report"
